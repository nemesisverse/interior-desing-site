# === Backend (server.js) ===
# Paste the connection string from Neon → Dashboard → Connection Details
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_jtPsvbh4aIO5@ep-muddy-bonus-azbuegn0-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Comma-separated origins allowed to call the API in dev.
# In Render (production) set this to your Bluehost domain(s), e.g.
#   https://elevatedhomeinterio.com,https://www.elevatedhomeinterio.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Frontend (Vite) ===
# Base URL of the backend API. In dev leave as localhost.
# For the production build, .env.production overrides this.
VITE_API_URL=http://127.0.0.1:5001
